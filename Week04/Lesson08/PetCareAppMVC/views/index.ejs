<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Care Journal System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  
    <%- include ('partials/navbar') %>

  <main class="container pb-5">
    <section class="hero-shell text-center">
      <p class="eyebrow">Healthy pets, happier days</p>
      <h1 class="hero-title">Every pet story deserves to be remembered.</h1>
      <p class="hero-copy">Keep activities, health notes and daily care organised in one friendly place built for you and your companions.</p>
      <div class="mt-4">
        <% if (!session || !session.user) { %>
          <a href="/signup" class="btn btn-primary btn-lg me-2">Start a Pet Journal</a>
          <a href="/login" class="btn btn-outline-secondary btn-lg">I Have an Account</a>
        <% } else { %>
          <a href="/journals" class="btn btn-success btn-lg">View My Journals</a>
        <% } %>
      </div>
    </section>

    <section class="row g-4 mt-4" aria-label="PetCare features">
      <div class="col-md-4"><div class="feature-card"><span class="feature-icon">📔</span><h3 class="h5">Daily journals</h3><p class="mb-0 text-secondary">Record walks, meals, appointments and memorable moments.</p></div></div>
      <div class="col-md-4"><div class="feature-card"><span class="feature-icon">🔎</span><h3 class="h5">Easy searching</h3><p class="mb-0 text-secondary">Find past activities and care notes whenever you need them.</p></div></div>
      <div class="col-md-4"><div class="feature-card"><span class="feature-icon">🐶</span><h3 class="h5">Multiple pets</h3><p class="mb-0 text-secondary">Keep every companion's information organised separately.</p></div></div>
    </section>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
